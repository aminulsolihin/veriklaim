# Copy to .env for local use, or set these in your host's dashboard. Never commit real values.

# development (default) or production. Production marks the session cookie Secure and hides /api/docs.
APP_ENV=development

# Signs sessions and derives the card-number tokens. Use a long random value and keep it stable.
SECRET_KEY=change-me-to-a-long-random-string

# SQLite file by default. For Postgres paste the connection string from your provider, for example
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./veriklaim.db

# Passwords for the two demo accounts (usernames: verifikator, supervisor).
# If left empty, random passwords are generated on first start and printed in the server log.
VERIFIKATOR_PASSWORD=
SUPERVISOR_PASSWORD=

# Optional text shown on the sign-in page, for example the demo accounts for judges.
LOGIN_HINT=

# Limits
MAX_UPLOAD_MB=8
MAX_CLAIMS=2000
# Set to 0 to start without the synthetic sample batch.
SEED_SAMPLE=1

# Session cookie lifetime in hours, and its name.
SESSION_HOURS=8
SESSION_COOKIE=vk_session

# Judge mode: a "try without an account" button that gives each visitor a private copy of the sample.
# Set JUDGE_MODE=0 to switch it off after the selection.
JUDGE_MODE=1
GUEST_HOURS=24
MAX_GUESTS=300
GUEST_LOGINS_PER_IP_HOUR=60
GUEST_MAX_BATCHES=5
